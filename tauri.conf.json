{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地 AI 工作台",
  "version": "0.2.6",
  "identifier": "app.localai.engine-manager",
  "mainBinaryName": "local-engine-manager",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "本地 AI 工作台",
        "width": 1120,
        "height": 760,
        "minWidth": 520,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
